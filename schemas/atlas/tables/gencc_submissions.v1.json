{
  "$comment": "Exported by `chd-atlas schemas export` from src/chd_atlas/tables.py; do not edit.",
  "fields": [
    {
      "constraints": {
        "pattern": "^SGC-\\d+$",
        "required": true
      },
      "name": "sgc_id",
      "type": "string"
    },
    {
      "constraints": {
        "pattern": "^HGNC:\\d+$",
        "required": true
      },
      "description": "In a source package this column holds the ids the manifest's `ids` names. When that is not `hgnc_id`, the cells are the source's own ids (symbols or Ensembl gene ids) and this field's `pattern` does not apply to them: `chd-atlas ingest` rewrites each to the HGNC id it resolves to, and names every id that does not resolve and writes none of its rows.",
      "name": "gene",
      "type": "string"
    },
    {
      "constraints": {
        "required": true
      },
      "name": "gene_symbol",
      "type": "string"
    },
    {
      "constraints": {
        "pattern": "^MONDO:\\d{7}$",
        "required": true
      },
      "name": "disease",
      "type": "string"
    },
    {
      "constraints": {
        "required": true
      },
      "name": "disease_label",
      "type": "string"
    },
    {
      "constraints": {
        "required": true
      },
      "name": "moi",
      "type": "string"
    },
    {
      "constraints": {
        "enum": [
          "Definitive",
          "Disputed Evidence",
          "Limited",
          "Moderate",
          "No Known Disease Relationship",
          "Refuted Evidence",
          "Strong",
          "Supportive"
        ],
        "required": true
      },
      "name": "classification",
      "type": "string"
    },
    {
      "constraints": {
        "required": true
      },
      "name": "submitter",
      "type": "string"
    },
    {
      "constraints": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}.*$",
        "required": false
      },
      "name": "submitted_on",
      "type": "string"
    },
    {
      "constraints": {
        "required": false
      },
      "name": "report_url",
      "type": "string"
    }
  ],
  "geneColumn": "gene",
  "layout": {
    "flat": "gencc_submissions.tsv"
  },
  "missingValues": [
